{
  "schema": "gicv2-lab.scenario.v1",
  "id": "h4i-context-save-restore-raspi4b-v1",
  "description": "H4i paused virtual-interface context save and restore on the raspi4b machine. Identical semantic contract to h4i-context-save-restore-v1; the machine is raspi4b rather than raspi400 so that the same invocation runs on both the qemu-pi4 fork and unmodified upstream QEMU, which has no raspi400 machine. Used for fork-versus-upstream differential comparison.",
  "qemu": {
    "machine": "raspi4b",
    "cpu": "cortex-a72,has_el3=off"
  },
  "success_marker": "[gicv2-lab] H4i PASS",
  "failure_substrings": [
    " FAIL:",
    "unexpected physical IRQ"
  ],
  "semantic_markers": [
    "[gicv2-lab] H4i EL2 monitor",
    "[gicv2-lab] deliberate BRK",
